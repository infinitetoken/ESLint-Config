{
  "name": "@infinitetoken/eslint-config",
  "version": "0.1.6",
  "description": "Shared ESLint and Prettier configuration for InfiniteToken TypeScript packages",
  "keywords": [
    "config",
    "eslint",
    "eslintconfig",
    "prettier"
  ],
  "homepage": "https://github.com/infinitetoken/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/infinitetoken/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitetoken/eslint-config.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": "./index.cjs",
    "./npm-package": "./npm-package.cjs",
    "./prettier": "./prettier.cjs",
    "./react-native": "./react-native.cjs",
    "./server": "./server.cjs",
    "./vue": "./vue.cjs"
  },
  "files": [
    "index.cjs",
    "npm-package.cjs",
    "react-native.cjs",
    "server.cjs",
    "vue.cjs",
    "prettier.cjs"
  ],
  "scripts": {
    "fix": "eslint . --fix",
    "lint": "eslint .",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "node scripts/verify-exports.cjs",
    "verify": "npm run lint && npm test",
    "preversion": "npm run verify"
  },
  "prettier": "./prettier.cjs",
  "dependencies": {
    "@infinitetoken/eslint-config": "^0.1.5",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^1.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-vue": "^10.9.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.3",
    "vue-eslint-parser": "^10.4.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0"
  },
  "peerDependencies": {
    "eslint": "^9.9.0 || ^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-native": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
